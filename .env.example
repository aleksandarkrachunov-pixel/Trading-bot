# Exchange API credentials (only needed for live mode).
# Create keys with TRADE permission only — never enable withdrawals.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Some exchanges (e.g. OKX, KuCoin) also need a passphrase
EXCHANGE_API_PASSWORD=

# Trading 212 (Invest / Stocks ISA). In the app: Settings -> API (Beta) -> Generate API key.
# Generate the key while switched to your PRACTICE account for demo trading.
# Needed permissions: account, portfolio, orders:read, orders:execute, history:orders, metadata
T212_API_KEY=
T212_API_SECRET=

# Telegram alerts: create a bot with @BotFather, send it a message,
# then run `python -m tradingbot telegram-test` to discover your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
